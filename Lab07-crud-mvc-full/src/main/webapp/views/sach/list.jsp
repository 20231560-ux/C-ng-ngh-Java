<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><style>body{font-family:Arial;background:#f5f7fb;margin:30px}.box{background:white;padding:25px;border-radius:12px}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border:1px solid #ccc;padding:9px}th{background:#e9eef5}a{color:#1565c0}input{padding:9px;margin:4px}</style><div class="box"><h2>Danh sách sách</h2><form><input name="keyword" value="${param.keyword}" placeholder="Tìm theo tên hoặc tác giả"><button>Tìm</button></form><p><a href="?action=new">+ Thêm sách</a></p><table><tr><th>ID</th><th>Mã</th><th>Tên sách</th><th>Tác giả</th><th>NXB</th><th>Năm</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsSach}"><tr><td>${x.id}</td><td>${x.maSach}</td><td><a href="?action=detail&id=${x.id}">${x.tenSach}</a></td><td>${x.tacGia}</td><td>${x.nhaXuatBan}</td><td>${x.namXuatBan}</td><td><a href="?action=edit&id=${x.id}">Sửa</a> | <a href="?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><p><a href="${pageContext.request.contextPath}/">Trang chủ</a></p></div>