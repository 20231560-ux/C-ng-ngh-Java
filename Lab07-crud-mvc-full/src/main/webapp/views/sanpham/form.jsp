<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><style>body{font-family:Arial;background:#f5f7fb;margin:30px}.box{background:white;padding:25px;border-radius:12px}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border:1px solid #ccc;padding:9px}th{background:#e9eef5}a{color:#1565c0}input{padding:9px;margin:4px}</style><div class="box"><h2>${empty sp?'Thêm':'Sửa'} sản phẩm</h2><c:if test="${param.error=='validate'}"><p style="color:red">Giá phải > 0 và số lượng phải >= 0.</p></c:if><form method="post"><input type="hidden" name="id" value="${sp.id}"><p>Mã <input name="ma" value="${sp.ma}" required></p><p>Tên <input name="ten" value="${sp.ten}" required></p><p>Mô tả <input name="moTa" value="${sp.moTa}"></p><p>Giá <input name="gia" type="number" step="0.01" value="${sp.gia}" required></p><p>Số lượng <input name="soLuong" type="number" value="${sp.soLuong}" min="0" required></p><button>Lưu</button></form></div>