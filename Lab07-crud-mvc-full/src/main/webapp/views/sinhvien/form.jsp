<%@ page contentType="text/html;charset=UTF-8" %><style>body{font-family:Arial;background:#f5f7fb;margin:30px}.box{background:white;padding:25px;border-radius:12px}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border:1px solid #ccc;padding:9px}th{background:#e9eef5}a{color:#1565c0}input{padding:9px;margin:4px}</style><div class="box"><h2>${empty sv?'Thêm':'Sửa'} sinh viên</h2><form method="post"><input type="hidden" name="id" value="${sv.id}"><p>Mã SV <input name="maSinhVien" value="${sv.maSinhVien}" required></p><p>Họ tên <input name="hoTen" value="${sv.hoTen}" required></p><p>Email <input name="email" value="${sv.email}" type="email"></p><p>Lớp <input name="lop" value="${sv.lop}"></p><button>Lưu</button></form><p><a href="${pageContext.request.contextPath}/sinh-vien">Quay lại</a></p></div>