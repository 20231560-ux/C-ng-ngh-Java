<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><style>body{font-family:Arial;background:#f5f7fb;margin:30px}.box{background:white;padding:25px;border-radius:12px}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border:1px solid #ccc;padding:9px}th{background:#e9eef5}a{color:#1565c0}input{padding:9px;margin:4px}</style><div class="box"><h2>Danh sách sinh viên</h2><form><input name="keyword" value="${param.keyword}" placeholder="Tìm theo tên hoặc lớp"><button>Tìm</button></form><p><a href="?action=new">+ Thêm sinh viên</a></p><table><tr><th>ID</th><th>Mã SV</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsSinhVien}"><tr><td>${x.id}</td><td>${x.maSinhVien}</td><td><a href="?action=detail&id=${x.id}">${x.hoTen}</a></td><td>${x.email}</td><td>${x.lop}</td><td><a href="?action=edit&id=${x.id}">Sửa</a> | <a href="?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><p><a href="${pageContext.request.contextPath}/">Trang chủ</a></p></div>