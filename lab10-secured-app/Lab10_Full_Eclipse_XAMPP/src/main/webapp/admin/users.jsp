<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,vn.edu.eaut.lab10.model.User" %><html><head><meta charset="UTF-8"><title>Quản lý tài khoản</title></head><body><h1>QUẢN LÝ TÀI KHOẢN</h1><%if(request.getAttribute("success")!=null){%><p style="color:green"><%=request.getAttribute("success")%></p><%}%><%if(request.getAttribute("error")!=null){%><p style="color:red"><%=request.getAttribute("error")%></p><%}%><h2>Thêm tài khoản</h2><form method="post" action="${pageContext.request.contextPath}/admin/users"><input type="hidden" name="action" value="add">Email <input type="email" name="email" required> Mật khẩu <input type="password" name="password" required> Họ tên <input name="fullName" required><select name="role"><option>ADMIN</option><option>STAFF</option><option>USER</option></select><button>Thêm</button></form><hr><table border="1" cellpadding="8"><tr><th>ID</th><th>Email</th><th>Họ tên</th><th>Role</th><th>Trạng thái</th><th>Thao tác</th></tr><%for(User x:(List<User>)request.getAttribute("users")){%><tr><td><%=x.getId()%></td><td><%=x.getEmail()%></td><td><%=x.getFullName()%></td><td><%=x.getRole()%></td><td><%=x.isActive()?"Hoạt động":"Đã khóa"%></td><td><a href="${pageContext.request.contextPath}/admin/users?action=toggle&id=<%=x.getId()%>"><%=x.isActive()?"Khóa":"Mở"%></a> | <a href="${pageContext.request.contextPath}/admin/users?action=edit&id=<%=x.getId()%>">Sửa</a> | <a href="${pageContext.request.contextPath}/admin/users?action=delete&id=<%=x.getId()%>" onclick="return confirm('Xóa?')">Xóa</a></td></tr><%}%></table><%User e=(User)request.getAttribute("editUser");if(e!=null){%><hr><h2>Sửa tài khoản</h2><form method="post" action="${pageContext.request.contextPath}/admin/users"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<%=e.getId()%>">Họ tên <input name="fullName" value="<%=e.getFullName()%>" required> Role <select name="role"><option <%=e.getRole()==vn.edu.eaut.lab10.model.Role.ADMIN?"selected":""%>>ADMIN</option><option <%=e.getRole()==vn.edu.eaut.lab10.model.Role.STAFF?"selected":""%>>STAFF</option><option <%=e.getRole()==vn.edu.eaut.lab10.model.Role.USER?"selected":""%>>USER</option></select> Mật khẩu mới <input type="password" name="password"><button>Lưu</button></form><%}%><br><a href="${pageContext.request.contextPath}/dashboard.jsp">Dashboard</a></body></html>