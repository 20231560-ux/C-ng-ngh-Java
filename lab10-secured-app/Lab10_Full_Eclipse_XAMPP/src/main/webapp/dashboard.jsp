<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="vn.edu.eaut.lab10.model.*" %><%User u=(User)session.getAttribute("currentUser");if(u==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;}%><html><head><meta charset="UTF-8"><title>Dashboard</title></head><body><h1>Dashboard</h1><h3>Xin chào: <%=u.getFullName()%></h3><p>Email: <%=u.getEmail()%></p><p>Role: <%=u.getRole()%></p><hr><%if(u.getRole()==Role.ADMIN){%><h3>MENU ADMIN</h3><a href="${pageContext.request.contextPath}/admin/users">Quản lý tài khoản</a><br><br><a href="${pageContext.request.contextPath}/staff/students">Quản lý Sinh viên</a><br><br><a href="${pageContext.request.contextPath}/staff/books">Quản lý Sách</a><br><br><a href="${pageContext.request.contextPath}/staff/products">Quản lý Sản phẩm</a><br><br><%}else if(u.getRole()==Role.STAFF){%><h3>MENU STAFF</h3><a href="${pageContext.request.contextPath}/staff/students">Sinh viên</a><br><br><a href="${pageContext.request.contextPath}/staff/books">Sách</a><br><br><a href="${pageContext.request.contextPath}/staff/products">Sản phẩm</a><br><br><%}else{%><h3>MENU USER</h3><a href="${pageContext.request.contextPath}/user/profile">Hồ sơ cá nhân</a><br><br><a href="${pageContext.request.contextPath}/user/password">Đổi mật khẩu</a><br><br><%}%><a href="${pageContext.request.contextPath}/auth?action=logout">Đăng xuất</a></body></html>