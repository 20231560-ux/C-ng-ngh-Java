<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,vn.edu.eaut.lab10.model.Book" %><%Book e=(Book)request.getAttribute("edit");%><html><head><meta charset="UTF-8"><title>Sách</title></head><body><h1>QUẢN LÝ SÁCH</h1><form method="post" action="${pageContext.request.contextPath}/staff/books"><input type="hidden" name="id" value="<%=e!=null?e.getId():""%>"><p>Mã sách: <input name="code" value="<%=e!=null?e.getCode():\"\">" required></p><p>Tên sách: <input name="title" value="<%=e!=null?e.getTitle():\"\">" required></p><p>Tác giả: <input name="author" value="<%=e!=null?e.getAuthor():\"\">" required></p><p>Số lượng: <input name="quantity" value="<%=e!=null?e.getQuantity():\"\">" required></p><button>Lưu</button></form><hr><table border="1" cellpadding="8"><tr><th>ID</th><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Số lượng</th><th>Thao tác</th></tr><%for(Book x:(List<Book>)request.getAttribute("items")){%><tr><td><%=x.getId()%></td><td><%=x.getCode()%></td><td><%=x.getTitle()%></td><td><%=x.getAuthor()%></td><td><%=x.getQuantity()%></td><td><a href="${pageContext.request.contextPath}/staff/books?action=edit&id=<%=x.getId()%>">Sửa</a> | <a href="${pageContext.request.contextPath}/staff/books?action=delete&id=<%=x.getId()%>" onclick="return confirm('Xóa?')">Xóa</a></td></tr><%}%></table><br><a href="${pageContext.request.contextPath}/dashboard.jsp">Dashboard</a></body></html>