<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,vn.edu.eaut.lab10.model.Student" %><%Student e=(Student)request.getAttribute("edit");%><html><head><meta charset="UTF-8"><title>Sinh viên</title></head><body><h1>QUẢN LÝ SINH VIÊN</h1><form method="post" action="${pageContext.request.contextPath}/staff/students"><input type="hidden" name="id" value="<%=e!=null?e.getId():""%>"><p>Mã SV: <input name="code" value="<%=e!=null?e.getCode():\"\">" required></p><p>Họ tên: <input name="fullName" value="<%=e!=null?e.getFullName():\"\">" required></p><p>Email: <input name="email" value="<%=e!=null?e.getEmail():\"\">" required></p><p>Ngành: <input name="major" value="<%=e!=null?e.getMajor():\"\">" required></p><button>Lưu</button></form><hr><table border="1" cellpadding="8"><tr><th>ID</th><th>Mã SV</th><th>Họ tên</th><th>Email</th><th>Ngành</th><th>Thao tác</th></tr><%for(Student x:(List<Student>)request.getAttribute("items")){%><tr><td><%=x.getId()%></td><td><%=x.getCode()%></td><td><%=x.getFullName()%></td><td><%=x.getEmail()%></td><td><%=x.getMajor()%></td><td><a href="${pageContext.request.contextPath}/staff/students?action=edit&id=<%=x.getId()%>">Sửa</a> | <a href="${pageContext.request.contextPath}/staff/students?action=delete&id=<%=x.getId()%>" onclick="return confirm('Xóa?')">Xóa</a></td></tr><%}%></table><br><a href="${pageContext.request.contextPath}/dashboard.jsp">Dashboard</a></body></html>