<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,vn.edu.eaut.lab10.model.Product" %><%Product e=(Product)request.getAttribute("edit");%><html><head><meta charset="UTF-8"><title>Sản phẩm</title></head><body><h1>QUẢN LÝ SẢN PHẨM</h1><form method="post" action="${pageContext.request.contextPath}/staff/products"><input type="hidden" name="id" value="<%=e!=null?e.getId():""%>"><p>Mã SP: <input name="code" value="<%=e!=null?e.getCode():\"\">" required></p><p>Tên sản phẩm: <input name="name" value="<%=e!=null?e.getName():\"\">" required></p><p>Giá: <input name="price" value="<%=e!=null?e.getPrice():\"\">" required></p><p>Số lượng: <input name="quantity" value="<%=e!=null?e.getQuantity():\"\">" required></p><button>Lưu</button></form><hr><table border="1" cellpadding="8"><tr><th>ID</th><th>Mã SP</th><th>Tên sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thao tác</th></tr><%for(Product x:(List<Product>)request.getAttribute("items")){%><tr><td><%=x.getId()%></td><td><%=x.getCode()%></td><td><%=x.getName()%></td><td><%=x.getPrice()%></td><td><%=x.getQuantity()%></td><td><a href="${pageContext.request.contextPath}/staff/products?action=edit&id=<%=x.getId()%>">Sửa</a> | <a href="${pageContext.request.contextPath}/staff/products?action=delete&id=<%=x.getId()%>" onclick="return confirm('Xóa?')">Xóa</a></td></tr><%}%></table><br><a href="${pageContext.request.contextPath}/dashboard.jsp">Dashboard</a></body></html>